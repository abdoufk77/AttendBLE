<?xml version="1.0" encoding="utf-8"?>
<!--
  Config réseau DEV : autorise le trafic HTTP cleartext pour TOUT host.
  Plus besoin de mettre à jour cette config quand l'IP du backend change
  (LAN café, hotspot mobile, etc.) — l'IP/port sont gérés dans local.properties.

  À durcir avant la prod (Azure HTTPS) : retirer base-config et lister
  uniquement les domaines de prod.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
