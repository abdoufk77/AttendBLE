<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Bluetooth legacy (API ≤ 30) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Bluetooth runtime (API ≥ 31) — neverForLocation pour ne pas demander LOCATION -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- BLE scan sur API ≤ 30 a besoin de la localisation -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <application
        android:name=".AttendBleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AttendBLE">
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.SignupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.prof.profil.ProfilActivity"
            android:exported="false" />
        <activity
            android:name=".ui.prof.classes.MyClassesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.prof.classes.ClassDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.prof.classes.CreerClasseActivity"
            android:exported="false" />
        <activity
            android:name=".ui.prof.serve.ServeHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.prof.serve.ActiveSessionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.prof.serve.SessionClosedActivity"
            android:exported="false" />
        <activity
            android:name=".ui.prof.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.profil.ProfilActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.classes.MyClassesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.classes.JoinClassActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.scan.SearchingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.scan.SessionCodeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.scan.face.FaceEnrollmentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.scan.face.FaceEnrollmentSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.scan.face.FaceEnrollmentErrorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.scan.face.FaceVerificationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.scan.face.FaceVerificationErrorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.scan.AttendanceSuccessActivity"
            android:exported="false" />
    </application>

</manifest>